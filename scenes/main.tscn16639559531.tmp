[sub_resource type="GDScript" id="GDScript_tbgi4"]
script/source = "extends AnimatedSprite2D
func anim_in():
	var tween = create_tween()
	tween.tween_property(self, 'offset_transform_scale', Vector2(1.25, 1.25), 0.2)
	tween.tween_callback(
		func(): tween.kill()
	)

func anim_out():
	var tween = create_tween()
	tween.tween_property(self, 'offset_transform_scale', Vector2(1, 1), 0.2)
	tween.tween_callback(
		func(): tween.kill()
	)
"

