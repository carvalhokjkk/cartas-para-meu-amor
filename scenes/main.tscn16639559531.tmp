[sub_resource type="GDScript" id="GDScript_muem4"]
script/source = "extends buttons


func _on_on_pressed() -> void:
	$\"../../nocards/mensagem\".hide()
	$\"../paper/alfabet\".text = ''
	$\"../paper/alfabet\".reload()
	await get_tree().create_timer(.1).timeout
	hide()
	$\"../paper\".show()
	$\"../paper\".play(\"default\")
	$\"../paper_anim\".play(\"in\")
	await get_tree().create_timer(.2).timeout
	$\"../teclado_anim\".play(\"in\")
	await get_tree().create_timer(0.15).timeout
	$\"../close_button\".show()
"

