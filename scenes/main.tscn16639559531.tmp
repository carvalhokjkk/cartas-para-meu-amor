[sub_resource type="GDScript" id="GDScript_0ld40"]
script/source = "extends buttons


func _ready() -> void:
	set_configs()
	hide() 

func _on_on_pressed() -> void:
	$\"../paper/alfabet\".text = ''
	$\"../teclado\".value = ''
	$\"../teclado_anim\".play_backwards(\"in\")
	$\"../paper\".play(\"close\")
	hide()
	$\"../paper_anim\".play_backwards(\"in\")
	await $\"../paper_anim\".animation_finished
	$\"../escrever_button\".show()
	$\"../../nocards/mensagem\".show()
"

